nome: 2_amarelo
tipo: objeto
camada: pouso
conjunto: faroeste
tamanho: 8x8
luz: emissivo
encaixe: nenhum
uso: sinal da base de pouso, quadro "amarelo"; fica em cima dos postes das pontas; mesmo tamanho e mesma base nos quatro quadros para trocar sem pular

paleta:
  . transparente
  a vermelho_laranja:2   luz amarela acesa, borda
  b vermelho_laranja:3   luz amarela acesa, base
  c vermelho_laranja:4   luz amarela acesa, brilho
  w olivas:4   luz amarela acesa, núcleo
  t neutros_quentes:4   suporte, luz
  m neutros_quentes:3   suporte, base
  s neutros_quentes:2   suporte, sombra
  G neutros_quentes:1   suporte, sombra funda

pixels:
..abba..
.bcwcba.
