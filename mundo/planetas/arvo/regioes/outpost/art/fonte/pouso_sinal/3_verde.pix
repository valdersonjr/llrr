nome: 3_verde
tipo: objeto
camada: pouso
conjunto: faroeste
tamanho: 8x8
luz: emissivo
encaixe: nenhum
uso: sinal da base de pouso, quadro "verde"; fica em cima dos postes das pontas; mesmo tamanho e mesma base nos quatro quadros para trocar sem pular

paleta:
  . transparente
  a verdes:1   luz verde acesa: pouso bom, borda
  b verdes:2   luz verde acesa: pouso bom, base
  c verdes:3   luz verde acesa: pouso bom, brilho
  w verdes:4   luz verde acesa: pouso bom, núcleo
  t neutros_quentes:4   suporte, luz
  m neutros_quentes:3   suporte, base
  s neutros_quentes:2   suporte, sombra
  G neutros_quentes:1   suporte, sombra funda

