  L magentas:5          crista da marola ao sol
  l magentas:4          plano de cima da areia
  g terras:3            areia, face
  r terras:2            traço de areia na sombra
  k terras:1            oclusão sob a pedra
  q neutros_quentes:4   pedrinha, luz
  p neutros_quentes:3   pedrinha
  n neutros_quentes:2   pedrinha, sombra

