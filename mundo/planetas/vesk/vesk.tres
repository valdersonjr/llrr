[resource]
script = ExtResource("1_esquema")
nome = "Vesk"
assunto = "Rocha fria, sem ar nenhum e com um sexto da gravidade de Arvo. O que cai aqui cai devagar, e o que é empurrado não volta sozinho: a pedra solta no céu não é enfeite, é o lugar sendo o que é."
