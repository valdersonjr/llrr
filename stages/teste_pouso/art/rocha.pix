# Corpo do terreno, 32x32, repetido pelo Polygon2D da fase. O ruído usa
# frequências inteiras em seno, que fecham no torus — por isso não há
# emenda visível quando o tile repete.
name: rocha
size: 32x32
light: top-left

palette:
  . transparent
  A #0f1322  rocha, sombra profunda
  B #161b2e  rocha, sombra
  C #1f2740  rocha, base
  D #2a3352  rocha, luz
  E #414d75  rocha, aresta iluminada

