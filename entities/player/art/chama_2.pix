# Chama do propulsor principal, quadro 2 de 2.
#
# Desenhada de cima para baixo a partir do bocal: o topo é a raiz, e é lá que
# fica o núcleo. O script da nave corta a altura pelo acelerador via
# region_rect, então encurtar precisa continuar fazendo sentido.
#
# A rampa vai de azul-branco (gás mais quente, na garganta) para laranja e
# vermelho na ponta — calor real, não amarelo chapado.
name: chama_2
size: 16x16
light: none

palette:
  . transparent
  b #bfe2ff  garganta, mais quente
  W #fffdf2  núcleo
  w #ffe6a4  interna
  F #ffb347  média
  f #ef7a3a  externa
  p #b8452f  ponta fria

pixels:
..ffFwWbbWwFff..
...fFwwWWwwFf...
..ffFwwWWwwFff..
..pfFFwWWwFFfp..
....fFFwwFFf....
....ffFwwFff....
....pfFFFFfp....
....pffFFffp....
.....pfFFfp.....
......ffff......
......pffp......
.......pp.......
................
................
................
................
