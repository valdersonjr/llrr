# Casco interceptador.
#
# Cunha estreita que abre para baixo, asas em flecha e um bocal só, grande.
# Pernas recolhidas e pé pequeno: ele voa bem e pousa mal, que é o preço.
#
# Envelope de colisão: pés tocam em y=27, bocal sai em y=24.
name: interceptador
size: 32x32
light: top-left

palette:
  . transparent
  K #141a2e  contorno
  A #222b4b  casco, sombra de ambiente
  d #3c4d7d  casco, sombra
  c #55689f  casco, meio-tom
  C #7189bd  casco, base
  L #9db3dc  casco, luz
  W #d5e3f7  casco, brilho
  n #2c3040  metal, sombra profunda
  m #464d60  metal, sombra
  M #6f7789  metal, meio
  N #9aa2b4  metal, luz
  E #cdd4e2  metal, brilho
  q #6b4a3c  derrame quente fraco
  Q #a06a45  derrame quente forte
  h #7a4a17  vidro, sombra
  g #e0a83c  vidro
  G #ffe9a8  vidro, reflexo
  R #7d93cc  luz de borda

