# Casco utilitário leve — nave inicial do jogador.
#
# Silhueta de quadro aberto: dois montantes verticais que continuam como
# pernas, uma viga de topo com a cabine em cima, e o pod pressurizado
# pendurado entre eles. Os dois vazios laterais são o que torna a mancha
# preta reconhecível a 32px — foi por eles que este desenho foi escolhido
# contra três alternativas, julgadas em preto antes de qualquer cor.
#
# A linguagem de forma é a do papel: quadro aberto = utilitário leve. O
# cargueiro resistente será uma caixa fechada, o interceptador uma cunha.
#
# Pixel art moderna: luz principal em top-left, sombra puxando para o azul do
# ambiente, luz de borda fria na aresta voltada para o fundo, e o motor
# derramando pixels quentes na barriga do pod.
#
# Envelope de colisão: pés tocam em y=28, bocal sai em y=23, montantes em
# x4..x27. Mexer nisso exige refazer utilitario_leve.tscn.
name: utilitario_leve
size: 32x32
light: top-left

palette:
  . transparent
  K #141a2e  contorno
  A #222b4b  casco, sombra de ambiente
  d #3c4d7d  casco, sombra
  c #55689f  casco, meio-tom
  C #7189bd  casco, base
  L #9db3dc  casco, luz
  W #d5e3f7  casco, brilho
  n #2c3040  metal, sombra profunda
  m #464d60  metal, sombra
  M #6f7789  metal, meio
  N #9aa2b4  metal, luz
  E #cdd4e2  metal, brilho
  q #6b4a3c  derrame quente fraco
  Q #a06a45  derrame quente forte
  h #7a4a17  vidro, sombra
  g #e0a83c  vidro
  G #ffe9a8  vidro, reflexo
  R #7d93cc  luz de borda
  x #3a3340  chapa chamuscada
  X #191c28  queimado, furo

