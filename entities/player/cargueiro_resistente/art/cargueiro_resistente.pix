# Casco cargueiro resistente.
#
# Laje maciça e fechada, com um contêiner amarrado no convés e dois bocais:
# o oposto do quadro vazado do utilitário leve. Pernas curtas e grossas,
# bem afastadas — ele pousa pesado e aguenta, mas custa a parar.
#
# Envelope de colisão: pés tocam em y=29, bocais saem em y=25.
name: cargueiro_resistente
size: 32x32
light: top-left

palette:
  . transparent
  K #141a2e  contorno
  A #222b4b  casco, sombra de ambiente
  d #3c4d7d  casco, sombra
  c #55689f  casco, meio-tom
  C #7189bd  casco, base
  L #9db3dc  casco, luz
  W #d5e3f7  casco, brilho
  n #2c3040  metal, sombra profunda
  m #464d60  metal, sombra
  M #6f7789  metal, meio
  N #9aa2b4  metal, luz
  E #cdd4e2  metal, brilho
  q #6b4a3c  derrame quente fraco
  Q #a06a45  derrame quente forte
  h #7a4a17  vidro, sombra
  g #e0a83c  vidro
  G #ffe9a8  vidro, reflexo
  R #7d93cc  luz de borda
  x #3a3340  chapa chamuscada
  X #191c28  queimado, furo

