# Cache do editor e assets importados — regenerado sozinho, nunca versionar
.godot/

# Build template do Android, regerado pelo editor
/android/

# Gerado pelo importador a partir dos CSV de localization/
*.translation

# Contém caminhos locais da máquina e, em build Android, senha de keystore.
