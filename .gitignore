# Cache do editor e assets importados — regenerado sozinho, nunca versionar
.godot/

# Build template do Android, regerado pelo editor
/android/

# Gerado pelo importador a partir dos CSV de localization/
*.translation

# Contém caminhos locais da máquina e, em build Android, senha de keystore.
# Se um dia quiser versionar os presets, remova a credencial antes.
export_presets.cfg
export.cfg

# macOS
.DS_Store

# Ambiente virtual de Python, se alguma ferramenta precisar de um
.venv/

# Cache do Python
__pycache__/

# Conferência que a skill de pixel art deixa ao lado do .pix; a fonte é o .pix e o PNG do jogo é gerado em art/
**/art/fonte/**/*.png
