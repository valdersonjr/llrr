  Y vermelho_laranja:4   faixa de aviso
  k neutros_quentes:1    faixa de aviso, escuro
  K neutros_quentes:0    lábio de baixo e contorno
  B neutros_frios:0      viga da treliça
  p neutros_frios:1      montante, luz
  P neutros_frios:0      montante
  q neutros_quentes:2    montante, sombra

